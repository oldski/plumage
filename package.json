{
  "name": "plumage",
  "private": true,
  "description": "Plumage: a multi-brand design system built on shadcn/ui, Radix, and Tailwind v4.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oldski/plumage.git"
  },
  "homepage": "https://plumage.oldskilabs.com",
  "type": "module",
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "visual": "pnpm --filter @plumage/visual visual",
    "visual:update": "pnpm --filter @plumage/visual visual:update",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
