{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "shadow": {
    "$type": "shadow",
    "$description": "Primitive elevation shadows. Soft shadows suit light surfaces; deep shadows stay visible on dark ones.",
    "soft": {
      "100": {
        "$value": {
          "color": "{color.black-alpha.8}",
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 1, "unit": "px" },
          "blur": { "value": 2, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        }
      },
      "200": {
        "$value": [
          {
            "color": "{color.black-alpha.8}",
            "offsetX": { "value": 0, "unit": "px" },
            "offsetY": { "value": 1, "unit": "px" },
            "blur": { "value": 2, "unit": "px" },
            "spread": { "value": 0, "unit": "px" }
          },
          {
            "color": "{color.black-alpha.8}",
            "offsetX": { "value": 0, "unit": "px" },
            "offsetY": { "value": 4, "unit": "px" },
            "blur": { "value": 12, "unit": "px" },
            "spread": { "value": -2, "unit": "px" }
          }
        ]
      },
      "300": {
        "$value": [
          {
            "color": "{color.black-alpha.12}",
            "offsetX": { "value": 0, "unit": "px" },
            "offsetY": { "value": 12, "unit": "px" },
            "blur": { "value": 32, "unit": "px" },
            "spread": { "value": -4, "unit": "px" }
          },
          {
            "color": "{color.black-alpha.8}",
            "offsetX": { "value": 0, "unit": "px" },
            "offsetY": { "value": 2, "unit": "px" },
            "blur": { "value": 6, "unit": "px" },
            "spread": { "value": 0, "unit": "px" }
          }
        ]
      }
    },
    "deep": {
      "100": {
        "$value": {
          "color": "{color.black-alpha.24}",
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 1, "unit": "px" },
          "blur": { "value": 2, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        }
      },
      "200": {
        "$value": [
          {
            "color": "{color.black-alpha.24}",
            "offsetX": { "value": 0, "unit": "px" },
            "offsetY": { "value": 1, "unit": "px" },
            "blur": { "value": 2, "unit": "px" },
            "spread": { "value": 0, "unit": "px" }
          },
          {
            "color": "{color.black-alpha.48}",
            "offsetX": { "value": 0, "unit": "px" },
            "offsetY": { "value": 4, "unit": "px" },
            "blur": { "value": 12, "unit": "px" },
            "spread": { "value": -2, "unit": "px" }
          }
        ]
      },
      "300": {
        "$value": [
          {
            "color": "{color.black-alpha.64}",
            "offsetX": { "value": 0, "unit": "px" },
            "offsetY": { "value": 12, "unit": "px" },
            "blur": { "value": 32, "unit": "px" },
            "spread": { "value": -4, "unit": "px" }
          },
          {
            "color": "{color.black-alpha.48}",
            "offsetX": { "value": 0, "unit": "px" },
            "offsetY": { "value": 2, "unit": "px" },
            "blur": { "value": 6, "unit": "px" },
            "spread": { "value": 0, "unit": "px" }
          }
        ]
      }
    }
  },
  "duration": {
    "$type": "duration",
    "$description": "Primitive durations.",
    "0": { "$value": { "value": 0, "unit": "ms" } },
    "75": { "$value": { "value": 75, "unit": "ms" } },
    "100": { "$value": { "value": 100, "unit": "ms" } },
    "150": { "$value": { "value": 150, "unit": "ms" } },
    "200": { "$value": { "value": 200, "unit": "ms" } },
    "250": { "$value": { "value": 250, "unit": "ms" } },
    "300": { "$value": { "value": 300, "unit": "ms" } },
    "400": { "$value": { "value": 400, "unit": "ms" } }
  },
  "easing": {
    "$type": "cubicBezier",
    "$description": "Primitive easing curves.",
    "linear": { "$value": [0, 0, 1, 1] },
    "standard": { "$value": [0.2, 0, 0, 1] },
    "decelerate": { "$value": [0, 0, 0, 1] },
    "accelerate": { "$value": [0.3, 0, 1, 1] },
    "overshoot": { "$value": [0.34, 1.4, 0.64, 1] }
  }
}
