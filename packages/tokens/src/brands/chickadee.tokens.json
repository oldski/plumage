  "radius": {
    "$type": "dimension",
    "$description": "Corner radius roles.",
    "indicator": {
      "$value": "{radius.100}",
      "$description": "Checkboxes and other small state indicators."
    },
    "control": {
      "$value": "{radius.200}",
      "$description": "Buttons, inputs, selects, small controls."
    },
    "container": {
      "$value": "{radius.300}",
      "$description": "Cards, panels, table wrappers."
    },
    "overlay": {
      "$value": "{radius.400}",
      "$description": "Dialogs, sheets, popovers, menus."
    },
    "pill": {
      "$value": "{radius.full}",
      "$description": "Badges and fully rounded elements."
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "body": {
        "$value": "{font.family.switzer}",
        "$description": "Interface and reading text."
      },
      "display": {
        "$value": "{font.family.gambetta}",
        "$description": "Page titles and hero numbers."
      },
      "numeric": {
        "$value": "{font.family.switzer}",
        "$description": "Figures in tables and stats, set with tabular numerals so columns align."
      },
      "mono": {
        "$value": "{font.family.jetbrains-mono}",
        "$description": "Code and fixed-width figures."
      }
    },
    "display": {
      "$description": "How the display face is set. A serif and a grotesk need different spacing, and weights read differently across families, so each brand tunes its own.",
      "tracking": {
        "$type": "number",
        "$value": 0,
        "$description": "Letter spacing for display text, in em."
      },
      "line-height": {
        "$type": "number",
        "$value": 1.05,
        "$description": "Multiplier on the density's line height for display text: 1 keeps it."
      },
      "weight": {
        "$type": "fontWeight",
        "$value": "{font.weight.500}",
        "$description": "Weight of display text."
      },
      "figures": {
        "$type": "string",
        "$value": "lining-nums proportional-nums",
        "$description": "font-variant-numeric for display text. Lining figures keep large numbers level with each other even when the face, or its fallback, defaults to oldstyle figures; proportional spacing looks even at display sizes."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "body": {
        "$value": "{font.weight.400}"
      },
      "label": {
        "$value": "{font.weight.500}"
      },
      "heading": {
        "$value": "{font.weight.500}"
      },
      "strong": {
        "$value": "{font.weight.600}"
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "$description": "Set to 0ms under prefers-reduced-motion by the CSS build.",
      "fast": {
        "$value": "{duration.150}",
        "$description": "Hover and press feedback."
      },
      "medium": {
        "$value": "{duration.200}",
        "$description": "Menus, tooltips, small reveals."
      },
      "slow": {
        "$value": "{duration.300}",
        "$description": "Dialogs and sheets."
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": "{easing.standard}",
        "$description": "Elements moving within the screen."
      },
      "enter": {
        "$value": "{easing.decelerate}",
        "$description": "Elements appearing."
      },
      "exit": {
        "$value": "{easing.accelerate}",
        "$description": "Elements leaving."
      }
    }
  },
  "focus": {
    "ring": {
      "$type": "dimension",
      "width": {
        "$value": "{border-width.200}"
      },
      "offset": {
        "$value": "{space.50}"
      }
    }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "default": {
        "$value": "{border-width.100}"
      },
      "strong": {
        "$value": "{border-width.200}",
        "$description": "Emphasis strokes: chart lines, the gap between touching chart marks."
      }
    }
  },
  "opacity": {
    "$type": "number",
    "disabled": {
      "$value": "{opacity.50}"
    }
  },
  "size": {
    "$type": "dimension",
    "overlay": {
      "$description": "Widths for floating panels: menus, tooltips, toasts, sheets, dialogs.",
      "2xs": {
        "$value": "{size.4000}"
      },
      "xs": {
        "$value": "{size.6000}"
      },
      "sm": {
        "$value": "{size.8000}"
      },
      "md": {
        "$value": "{size.11200}"
      },
      "lg": {
        "$value": "{size.16000}"
      }
    }
  }
