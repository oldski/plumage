{
  "name": "@plumage/docs",
  "version": "0.1.0",
  "private": true,
  "description": "Plumage documentation site (Storybook), which also serves the shadcn registry at /r.",
  "type": "module",
  "scripts": {
    "registry": "node --experimental-strip-types --no-warnings scripts/build-registry.ts && shadcn build registry.json --cwd .registry --output ../public/r",
    "dev": "pnpm registry && storybook dev --port 6006 --no-open",
    "build": "pnpm registry && storybook build --output-dir storybook-static --quiet",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@plumage/tokens": "workspace:^",
    "@plumage/ui": "workspace:^",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "shadcn": "4.23.0",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  }
}
