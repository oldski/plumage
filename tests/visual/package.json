{
  "name": "@plumage/visual",
  "version": "0.1.0",
  "private": true,
  "description": "Visual regression for Plumage: every Storybook story in every brand, mode, and density, screenshotted with Playwright against committed baselines.",
  "type": "module",
  "scripts": {
    "visual": "pnpm --filter @plumage/docs build && playwright test",
    "visual:update": "pnpm --filter @plumage/docs build && playwright test --update-snapshots",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.10.0",
    "typescript": "~5.9.3"
  }
}
